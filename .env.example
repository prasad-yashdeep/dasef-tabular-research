# DASEF project-only API keys.
# Copy to .env and fill locally. Never commit .env.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Optional provider/base URL overrides
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_BASE_URL=

# Experiment controls (all optional)
# DASEF_RAW_ONEHOT=1   set to 0 to load the cached core tables with their categorical columns as integer codes (pre-v1.1 behaviour)
# DASEF_FIG_PGF=1      typeset figure text with pdflatex (Latin Modern Type 1 fonts) when regenerating figures
# DASEF_ROOT=          repository root for scripts/run_classical_baselines.py when not run from the repo root
